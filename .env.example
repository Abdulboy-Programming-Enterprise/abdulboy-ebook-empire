# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
APP_NAME="Abdulboy Ebook Empire"
APP_VERSION=1.0.0
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-this-in-production-super-secret-key-12345!
APP_TIMEZONE=Africa/Lagos
APP_LOCALE=en

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------
API_URL=http://localhost:8000
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000/admin
FRONTEND_PORT=3000
BACKEND_PORT=8000
WORKER_PORT=5555

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION - PostgreSQL (Primary)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=abdulboy_ebook_empire
DB_USER=abdulboy_admin
DB_PASSWORD=change-this-strong-password-123!
DB_SSL_MODE=disable
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_ECHO=false

# Database Read Replica (for scaling)
DB_REPLICA_HOST=localhost
DB_REPLICA_PORT=5432
DB_REPLICA_USER=abdulboy_readonly
DB_REPLICA_PASSWORD=change-this-readonly-password-123!

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION - MongoDB (Analytics & Logs)
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=abdulboy_analytics
MONGODB_USER=abdulboy_admin
MONGODB_PASSWORD=change-this-mongodb-password-123!
MONGODB_AUTH_SOURCE=admin

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION - Redis (Cache & Sessions)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-this-redis-password-123!
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3
REDIS_SSL=false

# -----------------------------------------------------------------------------
# JWT AUTHENTICATION
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=change-this-jwt-secret-key-very-long-and-secure-12345!
JWT_REFRESH_SECRET_KEY=change-this-refresh-secret-key-different-from-above-12345!
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_RESET_TOKEN_EXPIRE_HOURS=24

# -----------------------------------------------------------------------------
# PAYMENT GATEWAYS
# -----------------------------------------------------------------------------
# Stripe Configuration
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
STRIPE_CURRENCY=usd

# OPay Configuration (Nigerian/African Market)
OPAY_MERCHANT_ID=your_opay_merchant_id_here
OPAY_PUBLIC_KEY=your_opay_public_key_here
OPAY_SECRET_KEY=your_opay_secret_key_here
OPAY_WEBHOOK_SECRET=your_opay_webhook_secret_here
OPAY_ENV=sandbox
OPAY_CURRENCY=NGN

# PayPal Configuration (Optional)
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD

# Flutterwave Configuration (Pan-African)
FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_public_key_here
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key_here
FLUTTERWAVE_ENCRYPTION_KEY=your_flutterwave_encryption_key_here
FLUTTERWAVE_WEBHOOK_SECRET=your_flutterwave_webhook_secret_here

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION (SendGrid/Mailgun/SMTP)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM=noreply@abdulboy-ebook.com
SMTP_FROM_NAME="Abdulboy Ebook Empire"

# SendGrid (Alternative)
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@abdulboy-ebook.com

# -----------------------------------------------------------------------------
# CLOUD STORAGE (AWS S3 / MinIO)
# -----------------------------------------------------------------------------
STORAGE_DRIVER=s3
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
AWS_BUCKET_NAME=abdulboy-ebook-empire
AWS_CLOUDFRONT_URL=https://your-cloudfront-url.cloudfront.net

# MinIO (Local Development)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=abdulboy-ebook-empire
MINIO_USE_SSL=false

# -----------------------------------------------------------------------------
# AI & MACHINE LEARNING
# -----------------------------------------------------------------------------
ML_MODEL_PATH=/storage/data/ml-models
SUGGESTION_ENGINE_TYPE=hybrid
CHATBOT_MODEL=distilbert
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ORGANIZATION=your_openai_org_here

# -----------------------------------------------------------------------------
# SECURITY & RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
ENABLE_GAMIFICATION=true
ENABLE_WATERMARKING=true
ENABLE_OPTIMIZATION=true
ENABLE_AFFILIATE=false
ENABLE_SOCIAL_LOGIN=false
ENABLE_BOOK_PREVIEW=true
ENABLE_PDF_COMPRESSION=true

# -----------------------------------------------------------------------------
# CDN & CACHING
# -----------------------------------------------------------------------------
CDN_ENABLED=false
CDN_URL=https://your-cdn-url.com
CACHE_TTL=3600
ASSET_VERSION=1

# -----------------------------------------------------------------------------
# WEBHOOKS & EXTERNAL SERVICES
# -----------------------------------------------------------------------------
WEBHOOK_FAILURE_THRESHOLD=3
WEBHOOK_RETRY_DELAY=5
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
SENTRY_DSN=your_sentry_dsn_here

# -----------------------------------------------------------------------------
# MONITORING & OBSERVABILITY
# -----------------------------------------------------------------------------
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_ENABLED=true
GRAFANA_PORT=3000
JAEGER_ENABLED=false
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# -----------------------------------------------------------------------------
# BACKUP & DISASTER RECOVERY
# -----------------------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_CRON_SCHEDULE="0 2 * * *"  # 2 AM daily
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/storage/backups

# -----------------------------------------------------------------------------
# ADMIN CONFIGURATION
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@abdulboy-ebook.com
ADMIN_USERNAME=abdulboy
ADMIN_PASSWORD_HASH=change-this-in-production

# -----------------------------------------------------------------------------
# DEFAULT SUBSCRIPTION PLANS
# -----------------------------------------------------------------------------
SUBSCRIPTION_FREE_PLAN_ID=free_001
SUBSCRIPTION_BASIC_PLAN_ID=basic_001
SUBSCRIPTION_PREMIUM_PLAN_ID=premium_001

# -----------------------------------------------------------------------------
# BOOK CONFIGURATION
# -----------------------------------------------------------------------------
MAX_BOOK_UPLOAD_SIZE=52428800  # 50MB
ALLOWED_BOOK_EXTENSIONS=pdf,epub,mobi
MAX_PREVIEW_PAGES=10
ENABLE_DRM=false
ENABLE_WATERMARK_BY_DEFAULT=true

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_FILE_PATH=/storage/data/logs
LOG_MAX_SIZE=10485760  # 10MB
LOG_BACKUP_COUNT=5
