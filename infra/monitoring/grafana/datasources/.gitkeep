# Grafana Datasources Directory
#
# Place your datasource configuration YAML files here.
#
# Example datasource YAML (prometheus.yaml):
# ---
# apiVersion: 1
# datasources:
#   - name: Prometheus
#     type: prometheus
#     url: http://prometheus:9090
#     access: proxy
#     isDefault: true
#     editable: false
# 
#   - name: Loki
#     type: loki
#     url: http://loki:3100
#     access: proxy
# 
#   - name: PostgreSQL
#     type: grafana-postgresql-datasource
#     url: postgres:5432
#     database: abdulboy_ebook_empire
#     user: ${DB_USER}
#     secureJsonData:
#       password: ${DB_PASSWORD}
