{
  "name": "@abdulboy/web",
  "version": "1.0.0",
  "description": "Frontend web application for Abdulboy Ebook Empire",
  "private": true,
  "scripts": {
    "dev": "webpack serve --config webpack.config.js --mode development",
    "build": "webpack --config webpack.prod.js --mode production",
    "build:dev": "webpack --config webpack.config.js --mode development",
    "watch": "webpack --watch --config webpack.config.js",
    "clean": "rm -rf dist",
    "lint": "eslint scripts/**/*.js",
    "lint:fix": "eslint scripts/**/*.js --fix",
    "format": "prettier --write 'scripts/**/*.js' 'styles/**/*.css' 'public/**/*.html'",
    "test": "jest",
    "test:watch": "jest --watch",
    "analyze": "ANALYZE=true webpack --config webpack.prod.js --mode production"
  },
  "dependencies": {
    "@stripe/stripe-js": "^2.4.0",
    "chart.js": "^4.4.0",
    "dayjs": "^1.11.10",
    "lodash": "^4.17.21",
    "swiper": "^11.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "autoprefixer": "^10.4.16",
    "babel-loader": "^9.1.3",
    "clean-webpack-plugin": "^4.0.0",
    "compression-webpack-plugin": "^10.0.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.1",
    "css-minimizer-webpack-plugin": "^5.0.1",
    "cssnano": "^6.0.1",
    "eslint": "^8.53.0",
    "eslint-plugin-prettier": "^5.0.1",
    "html-loader": "^4.2.0",
    "html-webpack-plugin": "^5.5.4",
    "jest": "^29.7.0",
    "mini-css-extract-plugin": "^2.7.6",
    "postcss": "^8.4.31",
    "postcss-loader": "^7.3.3",
    "postcss-preset-env": "^9.3.0",
    "prettier": "^3.0.3",
    "style-loader": "^3.3.3",
    "tailwindcss": "^3.3.5",
    "terser-webpack-plugin": "^5.3.9",
    "webpack": "^5.89.0",
    "webpack-bundle-analyzer": "^4.10.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "webpack-merge": "^5.10.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "moduleNameMapper": {
      "\\.(css|less|scss)$": "identity-obj-proxy"
    }
  }
}
