# =============================================================================
# BACKEND API ENVIRONMENT VARIABLES
# =============================================================================

# Application
APP_NAME=Abdulboy Ebook Empire API
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-this-in-production-super-secret-key
API_VERSION=v1

# Server
API_HOST=0.0.0.0
API_PORT=8000
WORKERS=4

# Database
DATABASE_URL=postgresql://abdulboy_admin:secure_password_123@localhost:5432/abdulboy_ebook_empire
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=secure_redis_123

# JWT
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLIC_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# OPay
OPAY_MERCHANT_ID=your_merchant_id
OPAY_PUBLIC_KEY=your_public_key
OPAY_SECRET_KEY=your_secret_key
OPAY_ENV=sandbox

# AWS S3
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=abdulboy-ebook-uploads

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_password
EMAIL_FROM=noreply@abdulboy-ebook.com

# Sentry
SENTRY_DSN=your_sentry_dsn

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
