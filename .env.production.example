# =============================================================================
# PRODUCTION ENVIRONMENT - DO NOT COMMIT ACTUAL SECRETS TO REPO
# =============================================================================

APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=${APP_SECRET_KEY}

DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
REDIS_URL=rediss://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# Production-specific settings
RATE_LIMIT_REQUESTS=500
RATE_LIMIT_PERIOD=60
CORS_ALLOWED_ORIGINS=https://abdulboy-ebook.com,https://www.abdulboy-ebook.com
ENABLE_SSL_REDIRECT=true
ENABLE_HSTS=true

# Production database
DB_HOST=abdulboy-rds-prod.xxxxxx.us-east-1.rds.amazonaws.com
DB_POOL_SIZE=50
DB_SSL_MODE=require

# Production Redis (ElastiCache)
REDIS_HOST=abdulboy-redis-prod.xxxxxx.cache.amazonaws.com
REDIS_SSL=true

# Production Stripe (Live Keys)
STRIPE_PUBLIC_KEY=pk_live_xxxxxxxx
STRIPE_SECRET_KEY=sk_live_xxxxxxxx

# Production OPay (Live)
OPAY_ENV=production

# Production monitoring
SENTRY_DSN=${SENTRY_DSN}
PROMETHEUS_ENABLED=true
